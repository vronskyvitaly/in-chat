generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int                @id @default(autoincrement())
  name          String
  email         String             @unique
  password      String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  roomId        Int?
  avatar        String?
  isOnline      Boolean            @default(false)
  lastSeen      DateTime           @default(now())
  status        String?
  city          String?
  maritalStatus String?
  languages     String[]           @default([])
  coverUrl      String?
  coverColor    String?
  chatMembers   ChatMember[]
  sentMessages  Message[]          @relation("MessageSender")
  posts         Post[]
  refreshTokens UserRefreshToken[]
  sentFriendRequests     Friendship[] @relation("SentFriendRequests")
  receivedFriendRequests Friendship[] @relation("ReceivedFriendRequests")
  comments               Comment[]
  likes                  Like[]
  photos                 Photo[]
  photoComments          PhotoComment[]
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  senderId  Int
  content   String?
  imageUrl  String?
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])

  @@index([chatId, createdAt])
}

model UserRefreshToken {
  id           Int      @id @default(autoincrement())
  userId       Int
  refreshToken String
  expiresAt    DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String?
  authorId  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]
  likes     Like[]
}

model Like {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  postId    Int
  authorId  Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Photo {
  id        Int            @id @default(autoincrement())
  url       String
  userId    Int
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  PhotoComment[]

  @@index([userId, createdAt])
}

model PhotoComment {
  id        Int      @id @default(autoincrement())
  content   String
  photoId   Int
  authorId  Int
  createdAt DateTime @default(now())
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([photoId, createdAt])
}

model Chat {
  id          String       @id @default(uuid())
  type        ChatType     @default(DIRECT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  lastMessage String?
  members     ChatMember[]
  messages    Message[]
}

model ChatMember {
  id     String @id @default(uuid())
  chatId String
  userId Int
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
}

enum ChatType {
  DIRECT
  GROUP
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id          Int              @id @default(autoincrement())
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  requester   User             @relation("SentFriendRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("ReceivedFriendRequests", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}
